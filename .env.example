# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Notion (optional — only needed for /setup_notion and /migrate_notion bot commands)
# NOTION_API_KEY=your_notion_integration_secret_here
# NOTION_DAILY_LOG_DB_ID=
# NOTION_PARENT_PAGE_ID=your_notion_parent_page_id_here

# Webhook (public HTTPS URL of your server)
WEBHOOK_BASE_URL=https://your-domain.com

# Auth (CHANGE THIS in production — used for JWT session tokens)
JWT_SECRET_KEY=change-me-to-a-random-64-char-string

# Defaults
DEFAULT_TARGET_KCAL=1800
DEFAULT_TARGET_PROTEIN=130
